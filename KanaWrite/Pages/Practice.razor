@inject NavigationManager Nav

@page "/Practice"

<PageTitle>Practice</PageTitle>

<h3>Practice</h3>

@code {
    #region Subtitle
    
    private string PageName => Nav.Uri.Split('/').Last();
    
    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        Layout?.SetSubtitle(PageName.ToLower());
    }
    
    #endregion
}