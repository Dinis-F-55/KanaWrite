<script>
    window.registerGlobalKeyListener = (dotnetHelper) => {
        window.globalKeyHandler = (e) => {
            if (e.repeat) return;
            
            if (e.code === 'Space' || e.key === ' ') {
                e.preventDefault();
                dotnetHelper.invokeMethodAsync('NextCharacter');
            }
            
            if (e.code === 'Backspace') {
                dotnetHelper.invokeMethodAsync('Undo');
            }
        };
        window.addEventListener('keydown', window.globalKeyHandler);
    };

    window.unregisterGlobalKeyListener = () => {
        window.removeEventListener('keydown', window.globalKeyHandler);
    };
</script>

