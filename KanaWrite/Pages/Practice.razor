    private void OnCheckboxChanged(int index, ChangeEventArgs e)
    {
        if (e.Value is not bool isChecked) return;
        _checkedRows?[index] = isChecked;
        SaveData();
    }
    
    private void SaveData()
    {
        LocalStorage.SetItemAsync("checkedRows", _checkedRows);
        Console.WriteLine("SAVED");
    }

    protected override async Task OnInitializedAsync()
    {
        Console.WriteLine("LOADED");
        await LoadData();
    }
    
    private async Task LoadData()
    {
        var savedRows = await LocalStorage.GetItemAsync<bool[]>("checkedRows");
    
        if (savedRows != null)
        {
            _checkedRows = savedRows;
        }
    }
    
    [JSInvokable]
    public void NextCharacter()
    {
        if (_currentKana != null)
        {
            _history.AddFirst(_currentKana);
            UpdateHistoryString();
        }

        var pickedKanas = kana
            .Where((row, index) => _checkedRows != null && _checkedRows[index])
            .SelectMany(row => row)
            .ToList();
        
        if (pickedKanas.Any())
        {
            var random = new Random();
            _currentKana = pickedKanas[random.Next(pickedKanas.Count)];
        }
        else
        {
            // Handle the case where no kana are selected
        }

        if (_history.Count >= 200)
        {
            _history.RemoveLast();
        }
        
        StateHasChanged();
        SaveData();
    }

    [JSInvokable]
    public void Undo()
    {
        if (_history.Count == 0) return;
        
        _currentKana = _history.First?.Value;
        
        _history.RemoveFirst();
        
        UpdateHistoryString();
        StateHasChanged();
    }

    private void UpdateHistoryString()
    {
        var sb = new StringBuilder();
        foreach (var kana in _history.Take(20))
        { 
            sb.Append(kana.Romaji)
                .Append("<span style=\"color: #B0BEC5;\"> | </span>")
                .Append(kana.Hira)
                .Append("<span style=\"color: #B0BEC5;\"> | </span>")
                .Append(kana.Kata)
                .Append("<br />");
        }

        _historyString = sb.ToString();
    }
    
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerGlobalKeyListener", _objRef);
        }
    }
    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("unregisterGlobalKeyListener");
        _objRef?.Dispose();
    }
