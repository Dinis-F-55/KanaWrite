@code {
    private double _currentPracticeButtonRotation = 0;
    private double _currentMarathonButtonRotation = 0;
    
    private void NavigateToPractice()
    {
        Nav.NavigateTo("/practice");
    }

    private void NavigateToMarathon()
    {
        Nav.NavigateTo("/marathon");
    }

    private void HandleMouseMovePracticeButton(MouseEventArgs e)
    {
        var distanceFromCenter = e.OffsetX - 80;
        _currentPracticeButtonRotation = distanceFromCenter / -20;
    }

    private void HandleMouseLeavePracticeButton()
    {
        _currentPracticeButtonRotation = 0;
    }
    
    private void HandleMouseMoveMarathonButton(MouseEventArgs e)
    {
        var distanceFromCenter = e.OffsetX - 80;
        _currentMarathonButtonRotation = distanceFromCenter / -20;
    }

    private void HandleMouseLeaveMarathonButton()
    {
        _currentMarathonButtonRotation = 0;
    }
}
