    <div class="description-container">
        <h3 class="section-title">Description</h3>
        <hr class="section-divider"/>

        <p class="description-text">
            A tool designed for active recall training of Hiragana and Katakana characters.
        </p>

        <h4 class="modes-header">Available Modes:</h4>

        <ul class="modes-list">
            <li>
                <strong class="mode-practice">Practice Mode:</strong>
                <p class="mode-desc">
                    Target specific rows. Review cards via audio cues, text cards, or both. Advance at your own pace while writing your answers down manually on your notepad.
                </p>
            </li>
            <li>
                <strong class="mode-marathon">Marathon Mode:</strong>
                <p class="mode-desc">
                    Test structural retention. Automatically cycles sequentially through the entire traditional kana matrix with an adjustable time delay between symbols.
                </p>
            </li>
        </ul>

        <div class="mode-buttons">
            <button class="practice-button"
                    @onclick="NavigateToPractice"
                    @onmousemove="HandleMouseMovePracticeButton"
                    @onmouseleave="HandleMouseLeavePracticeButton"
                    style="transform: rotate(@(_currentPracticeButtonRotation)deg);">
                Practice
            </button>
            <button class="marathon-button"
                    @onclick="NavigateToMarathon"
                    @onmousemove="HandleMouseMoveMarathonButton"
                    @onmouseleave="HandleMouseLeaveMarathonButton"
                    style="transform: rotate(@(_currentMarathonButtonRotation)deg);">
