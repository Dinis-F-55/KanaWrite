@inject NavigationManager Nav

@page "/Marathon"

<PageTitle>Marathon</PageTitle>


<div class="page">
    
</div>

@code {
    #region Subtitle
    
    private string PageName => Nav.Uri.Split('/').Last();
    
    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    protected override void OnInitialized()
    {
        Layout?.SetSubtitle(PageName.ToLower());
    }
    
    #endregion
}