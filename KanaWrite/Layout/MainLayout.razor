@inherits LayoutComponentBase
@inject NavigationManager Nav

<div class="page">
    <main>
        <div class="bg-shape shape-1">あ</div>
        <div class="bg-shape shape-2">ア</div>
        <div class="bg-shape shape-3">
            <img src="images/cherry-blossom.png" alt="Character"/>
        </div>
        
        <div class="top-row" style="border-image: linear-gradient(to right, transparent 0%, @(PageSubtitle == "practice" ? "#E39AE8" : PageSubtitle == "marathon" ? "#72D4E5" : "white") 50%, transparent 100%) 0 0 1 0;">
            <button class="app-title" @onclick="HomePage">
                <span class="tilt-kana">カ</span>naWrite
            </button>
            @if (!string.IsNullOrEmpty(PageSubtitle))
            {
                <span class="title-subtitle-separator" style="color: @(PageSubtitle == "practice" ? "#E39AE8" : "#72D4E5")">|</span>
                <span class="page-subtitle">@PageSubtitle</span>
                <button class="swap-button" @onclick="SwapPage">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left-right"><path d="M8 3 4 7l4 4"/><path d="M4 7h16"/><path d="m16 21 4-4-4-4"/><path d="M20 17H4"/></svg>
                </button>
            }
        </div>

        <button class="github-button">
            <a href="https://github.com/Dinis-F-55/KanaWrite" target="_blank" title="GitHub Repository" class="d-flex align-items-center text-dark text-decoration-none">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="white" class="bi bi-github" viewBox="0 0 16 16">
                    <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"/>
                </svg>
            </a>
        </button>
        
        <article class="content px-4">
            <CascadingValue Value="this">
                @Body
            </CascadingValue>
        </article>
    </main>
</div>

@code {
    private string? PageSubtitle { get; set; }
    
    public void SetSubtitle(string? title)
    {
        PageSubtitle = title;
        StateHasChanged();
    }

    private void SwapPage()
    {
        Nav.NavigateTo(PageSubtitle == "practice" ? "marathon" : "practice");
    }

    private void HomePage()
    {
        PageSubtitle = null;
        Nav.NavigateTo("");
    }
}